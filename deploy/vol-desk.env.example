# Copy to /etc/vol-desk.env on the VM (mode 600, root-owned) and fill in.
# See docs/INTEGRATIONS.md for what each variable is read by and why.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# D-028: the official alpacahq/alpaca-mcp-server, launched via uv. Requires
# `uv`/`uvx` on PATH (pipx install uv, or see astral.sh/uv). mcp_client.py
# passes ALPACA_API_KEY/ALPACA_SECRET_KEY through to this subprocess itself
# and always forces paper trading regardless of anything else in this file.
ALPACA_MCP_COMMAND="uvx alpaca-mcp-server"
GROQ_API_KEY=
VOL_DESK_DB=/home/voldesk/vol-desk/vol-desk.db
VOL_DESK_CONFIG=/home/voldesk/vol-desk/config
LOG_LEVEL=INFO
