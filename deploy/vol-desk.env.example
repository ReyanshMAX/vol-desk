# For a VM (docs/DEPLOY.md systemd path): copy to /etc/vol-desk.env, mode
# 600, root-owned. For a personal machine (docs/DEPLOY.md WSL2 path): copy
# to .env in the repo root, used by deploy/run_local.sh.
# See docs/INTEGRATIONS.md for what each variable is read by and why.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# D-028: the official alpacahq/alpaca-mcp-server, launched via uv. Requires
# `uv`/`uvx` on PATH (pipx install uv, or see astral.sh/uv). mcp_client.py
# passes ALPACA_API_KEY/ALPACA_SECRET_KEY through to this subprocess itself
# and always forces paper trading regardless of anything else in this file.
ALPACA_MCP_COMMAND="uvx alpaca-mcp-server"
GROQ_API_KEY=
LOG_LEVEL=INFO

# VOL_DESK_DB and VOL_DESK_CONFIG are deliberately left unset: config.py
# defaults them to ./vol-desk.db and ./config, which resolve correctly
# either way -- relative to WorkingDirectory on the systemd/VM path, and
# relative to the repo root that run_local.sh cd's into on a personal
# machine. Only set these explicitly if you need the DB or config
# somewhere other than the repo directory itself.
#VOL_DESK_DB=/home/voldesk/vol-desk/vol-desk.db
#VOL_DESK_CONFIG=/home/voldesk/vol-desk/config
